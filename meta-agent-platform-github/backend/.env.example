# Required for AI workflow generation and execution
OPENAI_API_KEY=your_openai_api_key

# Google OAuth Web Application credentials.
# Required only for Gmail / Google Calendar integrations.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback

# Optional settings
GMAIL_TRIGGER_POLL_SECONDS=60
FRONTEND_URL=http://127.0.0.1:3000
MAX_WORKFLOW_UPLOAD_MB=10
GOOGLE_HTTP_TIMEOUT_SECONDS=30

# Optional local proxy for Google APIs. Leave empty if not needed.
GOOGLE_PROXY_URL=
